# ~/gradeai/gradeai.env on Fir — read by gradeai-model.sbatch. Keep it private: chmod 600.

# The model in Hugging Face format (a folder with config.json and *.safetensors).
#  - Full fine-tuned model (e.g. `ilab model train` output, or a merged LoRA): put its folder here.
#  - LoRA adapter (e.g. Unsloth): put the BASE model here and the adapter folder in LORA_PATH.
MODEL_PATH=/project/def-CHANGEME/your-repo/models/BASE-MODEL

# Folder with adapter_config.json + adapter_model.safetensors. Leave empty for a full model.
LORA_PATH=

# Name the worker reports to GradeAI (shown in the app).
MODEL_NAME=gradeai-csc236

# Context window in tokens. Must not exceed what your base model supports:
#   granite-7b-lab: 4096   ·   granite-3.x-8b: up to 131072
# Keep GradeAI Settings → "Max submission length" at about 3 × this number of characters.
MAX_MODEL_LEN=8192

# Your GradeAI web server, and the WORKER_TOKEN set on it.
GRADEAI_URL=https://gradeai.example.ca
GRADEAI_WORKER_TOKEN=paste-the-same-WORKER_TOKEN-as-the-web-server

# Parallel requests to vLLM. vLLM batches them on the GPU; 8–16 is plenty for one H100.
WORKER_CONCURRENCY=8

# Structured JSON output: json_schema (recent vLLM), guided_json (older vLLM) or none.
JSON_MODE=json_schema

# Set to 1 to queue the next job automatically when one starts (keeps the model available).
RESUBMIT=0

# Extra flags for `vllm serve`. For Qwen3.5/3.6/3.8 models use --language-model-only
# (skips the vision encoder: GradeAI only sends text, and it frees GPU memory).
VLLM_EXTRA_ARGS=

# Qwen3-family models reason ("think") before answering unless this is false.
# Keep false unless your fine-tuning data included the reasoning.
ENABLE_THINKING=false
