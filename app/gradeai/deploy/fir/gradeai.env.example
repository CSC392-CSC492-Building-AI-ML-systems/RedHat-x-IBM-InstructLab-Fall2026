# ~/gradeai/gradeai.env on Fir: what the model job serves. Read by gradeai-serve.sbatch.

# The model folder in Hugging Face format (config.json + *.safetensors).
# This is your stage2_v2clean adapter merged into Qwen3.8-27B (made with merge-lora.sbatch).
MODEL_PATH=/project/def-engine14/RedHat-x-IBM-InstructLab-Fall2026/models/merged-v2clean

# Optional: serve an unmerged LoRA adapter on top of MODEL_PATH (then the BASE model) instead.
# Not recommended for Qwen3.8; leave empty when MODEL_PATH is a merged model.
LORA_PATH=

# The vLLM environment and the modules it was built with.
VLLM_VENV=/project/def-engine14/RedHat-x-IBM-InstructLab-Fall2026/env/model/.venv
MODULES="opencv/4.13 python/3.13 cuda/13.2"

# Name GradeAI shows for the model.
MODEL_NAME=gradeai-csc236

# Context window in tokens. Keep GradeAI Settings → "Max submission length" at about 3 × this
# number of characters, minus room for the rubric.
MAX_MODEL_LEN=16384
GPU_MEMORY_UTILIZATION=0.90

# Text only: skips Qwen3.8's vision encoder, leaving more GPU memory for grading.
VLLM_EXTRA_ARGS=--language-model-only
