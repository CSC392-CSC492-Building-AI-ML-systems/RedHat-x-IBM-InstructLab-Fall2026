# Copy to .env and fill in.

# Public address of GradeAI (used for invite links and secure cookies).
PUBLIC_URL=https://gradeai.example.ca
# Domain Caddy requests the HTTPS certificate for (docker-compose only).
GRADEAI_DOMAIN=gradeai.example.ca

# Shared secret for the Fir worker. Generate with:  openssl rand -hex 32
# Put the same value in GRADEAI_WORKER_TOKEN in ~/gradeai/gradeai.env on Fir.
WORKER_TOKEN=

# Optional
# PORT=8080
# DATA_DIR=./data              # SQLite database + uploaded files
# MAX_UPLOAD_MB=25             # per file
# SESSION_DAYS=14
# WORKER_TIMEOUT_SEC=90        # model shown offline after this long without a check-in
# TASK_LEASE_SEC=600           # a task not finished in this time goes back to the queue
