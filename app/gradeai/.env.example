# GradeAI on this computer. `npm run setup` fills in the first two; edit the rest by hand if you like.

# Your Alliance username, for signing in to Fir.
FIR_USER=
# Private token the worker uses to talk to GradeAI on this computer.
WORKER_TOKEN=

# Optional
# FIR_HOST=fir.alliancecan.ca
# PORT=8080                 # GradeAI opens at http://localhost:8080
# MODEL_HOURS=4             # how long a model job started by npm run model:connect runs (1-168)
# MODEL_TUNNEL_PORT=18000   # this computer's end of the SSH tunnel to the model
# WORKER_CONCURRENCY=8      # files graded at once
# JSON_MODE=json_schema     # json_schema | guided_json (older vLLM) | none
# ENABLE_THINKING=false     # true only if your training data included Qwen's reasoning
# DATA_DIR=./data           # database and uploaded files
# MAX_UPLOAD_MB=25          # per file
# SESSION_DAYS=14
