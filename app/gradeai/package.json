{
  "name": "gradeai",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "npm run build:server && node --env-file-if-exists=.env dist-server/index.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json",
    "build:web": "vite build",
    "build:server": "esbuild server/index.ts --bundle --platform=node --format=esm --target=node22 --packages=external --outfile=dist-server/index.mjs",
    "build": "npm run typecheck && npm run build:web && npm run build:server",
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env dist-server/index.mjs",
    "setup": "node scripts/setup.mjs",
    "model:connect": "bash scripts/fir.sh connect",
    "model:start": "bash scripts/fir.sh start",
    "model:status": "bash scripts/fir.sh status",
    "model:log": "bash scripts/fir.sh log",
    "model:stop": "bash scripts/fir.sh stop",
    "mock-model": "python3 scripts/mock-model.py 8001 local-key"
  },
  "dependencies": {
    "@fontsource/dm-mono": "^5.2.5",
    "@fontsource/lexend": "^5.2.5",
    "express": "^4.21.2",
    "jszip": "^3.10.1",
    "multer": "^2.0.2",
    "pdfjs-dist": "^4.10.38",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.11",
    "@types/express": "^4.17.23",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.5.2",
    "esbuild": "^0.25.5",
    "tailwindcss": "^4.1.11",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "GradeAI: AI-assisted grading for CSC236, run on your computer with a fine-tuned model served on Fir."
}
